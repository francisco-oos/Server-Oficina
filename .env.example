SERVER_OFICINA_ENV=production
SERVER_OFICINA_DATABASE_URL=postgresql+psycopg://serveroficina:URL_ENCODED_PASSWORD@127.0.0.1:5432/server_oficina
SERVER_OFICINA_DATA_DIR=/srv/server-oficina/data/app
SERVER_OFICINA_SESSION_HOURS=12
SERVER_OFICINA_COOKIE_SECURE=false
SERVER_OFICINA_HOST=0.0.0.0
SERVER_OFICINA_PORT=8080

SERVER_OFICINA_SYNC_ROOT=/srv/server-oficina/files
SERVER_OFICINA_VERSIONS_ROOT=/srv/server-oficina/versions
SERVER_OFICINA_SYNCTHING_API=http://127.0.0.1:8384
SERVER_OFICINA_SYNCTHING_API_KEY=
SERVER_OFICINA_WORKSTATION_SESSION_DAYS=15

# IA local opcional. Nunca configure un endpoint público para documentos reales.
SERVER_OFICINA_LLM_BASE_URL=http://127.0.0.1:8081/v1
SERVER_OFICINA_LLM_MODEL=
