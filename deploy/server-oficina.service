[Unit]
Description=Server Oficina - Adquisicion de Datos
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=serveroficina
Group=serveroficina
WorkingDirectory=/opt/server-oficina/current
EnvironmentFile=/etc/server-oficina/server-oficina.env
ExecStart=/opt/server-oficina/current/.venv/bin/python /opt/server-oficina/current/run.py
Restart=on-failure
RestartSec=3
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/server-oficina/data/app

[Install]
WantedBy=multi-user.target
